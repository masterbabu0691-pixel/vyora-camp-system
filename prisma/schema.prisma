generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. RBAC & USER MANAGEMENT
// ==========================================
model User {
  id        String     @id @default(cuid())
  name      String
  username  String     @unique
  password  String     // Will store hashed passwords, never plain text
  role      Role       @default(RECEPTION)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  
  // Relations for Audit Logs
  auditLogs AuditLog[]
}

// Defines the exact roles allowed in your system
enum Role {
  SUPER_ADMIN
  ADMIN
  RECEPTION
  DOCTOR
  PHLEBOTOMIST
  TECHNICIAN
}

// ==========================================
// 2. CLIENT & CAMP MANAGEMENT
// ==========================================
model Client {
  id         String   @id @default(cuid())
  clientCode String   @unique // Auto-generated: e.g., VHC-CL-2026-001
  name       String
  camps      Camp[]
  createdAt  DateTime @default(now())
}

model Camp {
  id              String     @id @default(cuid())
  campName        String
  campDate        DateTime
  clientId        String
  client          Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  // HR & Field Team Tracking
  leadDoctor      String?
  phlebotomist    String?
  campCoordinator String?
  technician      String?

  // Configurable Test Checklist stored as comma-separated or JSON string
  testChecklist   String     @default("CBC,RBS,URINE,STOOL,WIDAL,VISION,BP,BMI")

  employees       Employee[]
  createdAt       DateTime   @default(now())
}

// ==========================================
// 3. EMPLOYEE & MEDICAL WORKFLOW
// ==========================================
model Employee {
  id             String       @id @default(cuid())
  campId         String
  camp           Camp         @relation(fields: [campId], references: [id], onDelete: Cascade)
  serialNo       Int
  uhid           String       @unique
  certificateNo  String?      @unique // e.g., VHC/2026/FSSAI/0001
  
  empCode        String?
  name           String
  age            Int?
  sex            String?
  department     String?
  designation    String?
  contactNo      String?
  email          String?
  
  status         String       @default("REGISTERED") // REGISTERED, PHLEB_DONE, DOC_DONE, LAB_DONE, COMPLETED
  bloodCollected Boolean      @default(false)
  urineCollected Boolean      @default(false)
  
  vitals         Vitals?
  examination    Examination?
  labResults     LabResult[]
  conclusion     Conclusion?
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Vitals {
  id         String   @id @default(cuid())
  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  height     Float?
  weight     Float?
  bmi        Float?
  heartRate  Int?
  bloodPress String?
  spO2       Float?
}

model Examination {
  id             String   @id @default(cuid())
  employeeId     String   @unique
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  pastHistory    String?
  comorbidities  String?
  eyeRight       String?
  eyeLeft        String?
  colorBlindness String?
  ent            String?
  oral           String?
  headNeck       String?
  lungsChest     String?
  cardiovascular String?
  skinVaricose   String?
}

model LabResult {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  testName   String
  result     String?
  unit       String?
  flag       String?  // NORMAL, ABNORMAL, CRITICAL
}

model Conclusion {
  id          String   @id @default(cuid())
  employeeId  String   @unique
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fitness     String   // FIT, UNFIT, TEMPORARILY_UNFIT
  declaration String?  // Statutory FSSAI Form IX / Occupational Health text
  remarks     String?
  finalizedAt DateTime @default(now())
}

// ==========================================
// 4. SUPER ADMIN & SYSTEM SETTINGS
// ==========================================
model SystemSetting {
  id          String   @id @default(cuid())
  settingKey  String   @unique // e.g., "PRINT_MARGIN_TOP"
  settingVal  String   // e.g., "4.5cm"
  description String?  // e.g., "Top margin for Letterhead"
  updatedAt   DateTime @updatedAt
}

model TestMaster {
  id          String   @id @default(cuid())
  testName    String   @unique // e.g., "Hemoglobin (Hb)"
  category    String   // e.g., "Blood", "Urine", "Physical"
  unit        String?  // e.g., "g/dL"
  normalRange String?  // e.g., "13.5 - 17.5"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String   // e.g., "UPDATED_FITNESS", "DELETED_CLIENT"
  entity    String   // e.g., "Employee", "Client"
  entityId  String   // The ID of the record that was changed
  details   String?  // e.g., "Changed from UNFIT to FIT"
  timestamp DateTime @default(now())
}
