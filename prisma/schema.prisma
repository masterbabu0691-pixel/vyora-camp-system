generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Users & Setup ---
model User {
  id        String   @id @default(cuid())
  name      String
  username  String   @unique
  password  String 
  role      String   @default("RECEPTION") // SUPER_ADMIN, RECEPTION, PHLEBOTOMY, DOCTOR, LAB, REVIEW
  createdAt DateTime @default(now())
}

model Client {
  id         String   @id @default(cuid())
  clientCode String   @unique // Auto-generated: e.g., VHC-CL-2026-001
  name       String
  camps      Camp[]
  createdAt  DateTime @default(now())
}

model Camp {
  id               String     @id @default(cuid())
  campName         String
  campDate         DateTime
  clientId         String
  client           Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  // HR & Field Team Tracking
  leadDoctor       String?
  phlebotomist     String?
  campCoordinator String?
  technician       String?

  // Configurable Test Checklist stored as comma-separated or JSON string
  // Defaults to full occupational/FSSAI package
  testChecklist    String     @default("CBC,RBS,URINE,STOOL,WIDAL,VISION,BP,BMI")

  employees        Employee[]
  createdAt        DateTime   @default(now())
}

// --- Employee & Workflow ---
model Employee {
  id             String       @id @default(cuid())
  campId         String
  camp           Camp         @relation(fields: [campId], references: [id], onDelete: Cascade)
  serialNo       Int
  uhid           String       @unique
  certificateNo  String?      @unique // e.g., VHC/2026/FSSAI/0001
  
  empCode        String?
  name           String
  age            Int?
  sex            String?
  department     String?
  designation    String?
  contactNo      String?
  email          String?
  
  status         String       @default("REGISTERED") // REGISTERED, PHLEB_DONE, DOC_DONE, LAB_DONE, COMPLETED
  bloodCollected Boolean      @default(false)
  urineCollected Boolean      @default(false)
  
  vitals         Vitals?
  examination    Examination?
  labResults     LabResult[]
  conclusion     Conclusion?
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Vitals {
  id         String   @id @default(cuid())
  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  height     Float?
  weight     Float?
  bmi        Float?
  heartRate  Int?
  bloodPress String?
  spO2       Float?
}

model Examination {
  id             String   @id @default(cuid())
  employeeId     String   @unique
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  pastHistory    String?
  comorbidities  String?
  eyeRight       String?
  eyeLeft        String?
  colorBlindness String?
  ent            String?
  oral           String?
  headNeck       String?
  lungsChest     String?
  cardiovascular String?
  skinVaricose   String?
}

model LabResult {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  testName   String
  result     String?
  unit       String?
  flag       String?  // NORMAL, ABNORMAL, CRITICAL
}

model Conclusion {
  id          String   @id @default(cuid())
  employeeId  String   @unique
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fitness     String   // FIT, UNFIT, TEMPORARILY_UNFIT
  declaration String?  // Statutory FSSAI Form IX / Occupational Health text
  remarks     String?
  finalizedAt DateTime @default(now())
}